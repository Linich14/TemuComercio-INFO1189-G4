@page "/welcome"
@layout Web.WebUI.Shared.AuthLayout

@inject NavigationManager Navigation

<div class="relative min-h-screen m-auto w-full">
  <!-- Panel oscuro a la derecha -->
  <div class="absolute inset-y-0 right-0 w-full md:w-[480px] bg-black/70 z-0"></div>

  <!-- Contenido centrado dentro del panel derecho -->
  <div class="absolute inset-y-0 right-0 w-full md:w-[480px] z-10 flex items-center justify-center px-6">
    <div class="bg-white p-8 rounded-[32px] shadow-lg w-full max-w-[400px]">
      <h1 class="text-3xl font-bold text-[#0058BE] text-center border-0 outline-0 ring-0 focus:outline-none focus:ring-0 focus:border-0" style="border: none !important; outline: none !important;">Bienvenido al sistema</h1>
      <img src="assets/Temu.png" alt="logo temucomercio" class="w-48 h-48 mx-auto block" />
      <button
        @onclick="IrALogin"
        class="mx-auto block bg-[#0071CE] w-64 py-4 rounded-[32px] shadow text-white active:opacity-80 mb-2 transition delay-50 duration-300 ease-in-out hover:-translate-y-1 hover:scale-110">
        Iniciar Sesión
      </button>
    </div>
  </div>
</div>

@code {
    private void IrALogin()
    {
        Navigation.NavigateTo("/login");
    }
}
