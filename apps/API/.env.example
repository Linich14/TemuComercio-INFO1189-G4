# VARIABLES DE ENTORNO PARA DESARROLLO
# Copia este archivo como .env y configura tus valores reales

# Configuración de Django
SECRET_KEY=tu-secret-key-super-segura-aqui-generala-nueva
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development

# Configuración de Supabase
# Obtén estos valores desde tu dashboard de Supabase
# URL: https://app.supabase.com/project/TU_PROJECT_ID/settings/database
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Configuración de base de datos Supabase
SUPABASE_DB_HOST=db.tu-proyecto.supabase.co
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=tu-password-de-supabase
SUPABASE_DB_PORT=5432

# Configuración de producción (solo necesario en producción)
# ALLOWED_HOSTS=tudominio.com,www.tudominio.com

# Email (opcional para desarrollo)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-email@gmail.com
# EMAIL_HOST_PASSWORD=tu-app-password

# Redis (opcional para cache en producción)
# REDIS_URL=redis://localhost:6379/1

# APIs externas (opcional)
# API_KEY_EXTERNAL_SERVICE=tu-api-key-aqui

# Logging (opcional)
# LOG_LEVEL=INFO
# LOG_FILE_PATH=/var/log/django/app.log